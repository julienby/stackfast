# Copier en .env (gitignoré). Réglages de l'INSTANCE seulement : les secrets d'une app sont dans apps/<stack>/<slug>/.env.

# Nom de l'instance : préfixe des conteneurs, réseaux et images (deux instances sur une machine ne se mélangent pas).
STACKFAST_INSTANCE=main

# Hôte des apps en incubation : https://$APPS_HOST/<slug>/. En local : localhost (certificat local de Caddy).
APPS_HOST=apps.example.com

# uid/gid de l'utilisateur propriétaire des fichiers (id -u / id -g) : les conteneurs tournent avec.
HOST_UID=1000
HOST_GID=1000
