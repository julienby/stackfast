#!/usr/bin/env sh
# État de sécurité du serveur, en une commande. Pour chaque app : son propre audit (bin/audit : PHP servi vs dernier
# correctif, durcissement, failles composer), image en service, santé. Puis sauvegardes et proxy.
# Exit 1 si une action est nécessaire : utilisable en cron (`stackfast audit >/dev/null || alerte`).
. "$(dirname "$0")/lib.sh"

status=0
for slug in $(apps | cut -d' ' -f2); do
  d="$(app_dir "$slug")"; img="$(app_image "$slug"):current"
  echo "## $slug ($(json_get "$d/stackfast.json" recipe))"
  if [ -x "$d/bin/audit" ]; then
    ( cd "$d" && bin/audit ) || status=1
  fi
  # Un conteneur garde son ancienne image (donc l'ancien PHP) tant qu'il n'est pas recréé.
  c="$(app_container "$slug")"
  id="$(docker inspect -f '{{.Image}}' "$c" 2>/dev/null || true)"
  cur="$(docker image inspect -f '{{.Id}}' "$img" 2>/dev/null || true)"
  health="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$c" 2>/dev/null || true)"
  if [ -z "$id" ]; then echo "  conteneur : arrêté"
  elif [ "$id" != "$cur" ]; then echo "  conteneur : ANCIENNE IMAGE → stackfast up $slug"; status=1
  elif [ "$health" != healthy ]; then echo "  conteneur : $health → stackfast logs $slug"; status=1
  else echo "  conteneur : sain, image à jour"
  fi
done

# Sauvegardes : données et .env ne sont que sur ce serveur (data/ et .env sont hors git).
echo "## sauvegardes"
lb="$(last_backup)"
if [ -z "$lb" ]; then
  echo "  aucune sauvegarde → stackfast backup"; status=1
else
  age=$(( ( $(date +%s) - $(stat -c %Y "$lb") ) / 86400 ))
  if [ "$age" -gt "${BACKUP_MAX_AGE_DAYS:-2}" ]; then echo "  dernière : $(basename "$lb") (il y a $age j) → stackfast backup"; status=1
  else echo "  dernière : $(basename "$lb") (il y a $age j)"; fi
fi

echo "## proxy"
if docker inspect "$PROXY" >/dev/null 2>&1; then
  echo "  $(docker exec "$PROXY" caddy version | cut -d' ' -f1), image du $(docker inspect -f '{{.Created}}' "$(docker inspect -f '{{.Image}}' "$PROXY")" | cut -c1-10)"
else
  echo "  arrêté → stackfast proxy"; status=1
fi

echo
[ "$status" -eq 0 ] && echo "audit : rien à faire" || echo "audit : action nécessaire (voir ci-dessus)"
exit "$status"
