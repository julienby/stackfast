#!/usr/bin/env sh
# Vérifie une app, ou toutes : lint, marqueurs de conflit, tests. Lance le bin/check de chaque app.
#   bin/check            toutes les apps
#   bin/check <slug>     une app
. "$(dirname "$0")/lib.sh"

[ $# -gt 0 ] && targets="$1" || targets="$(apps | cut -d' ' -f2)"
[ -n "$targets" ] || { echo "rien à vérifier"; exit 0; }

status=0
for slug in $targets; do
  d="$(app_dir "$slug")"
  echo "### $slug"
  ( cd "$d" && bin/check ) || status=1
done
exit "$status"
