#!/usr/bin/env sh
# Vérifie une stack ou une app en appelant stacks/<stack>/check. Exit ≠ 0 si un test échoue.
#   bin/check                  toutes les stacks
#   bin/check php-htmx         une stack
#   bin/check php-htmx demo    une app
set -eu
cd "$(dirname "$0")/.."
STACK="${1:-}"
SLUG="${2:-}"
status=0

for s in $(ls stacks); do
  [ -n "$STACK" ] && [ "$s" != "$STACK" ] && continue
  if [ -x "stacks/$s/check" ]; then
    "stacks/$s/check" $SLUG || status=1
  else
    echo "stack sans vérification : $s"
  fi
done

[ "$status" -eq 0 ] && echo "CHECK OK" || echo "CHECK FAILED"
exit "$status"
