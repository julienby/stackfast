#!/usr/bin/env sh
# Déploie l'instance : git pull, puis chaque app démarrée/mise à jour et le proxy régénéré.
# Le code des apps est monté : un pull suffit pour lui. Une stack modifiée (Dockerfile, php.ini…) est
# reconstruite automatiquement par bin/up. Pour un correctif PHP sans changement du repo : stackfast update.
#   bin/deploy
. "$(dirname "$0")/lib.sh"

if [ -n "$(git config --get remote.origin.url 2>/dev/null)" ]; then
  git pull --ff-only
fi
exec "$ROOT/bin/up" --all
