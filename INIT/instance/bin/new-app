#!/usr/bin/env sh
# Crée apps/<stack>/<slug> depuis stacks/<stack>/app-template, puis lance stacks/<stack>/post-new-app s'il existe.
set -eu
cd "$(dirname "$0")/.."

STACK="${1:?usage: bin/new-app <stack> <slug>}"
SLUG="${2:?usage: bin/new-app <stack> <slug>}"
TEMPLATE="stacks/$STACK/app-template"
DEST="apps/$STACK/$SLUG"

case "$SLUG" in
  *[!a-z0-9-]*|-*|"") echo "slug invalide : [a-z0-9-], commence par une lettre ou un chiffre" >&2; exit 1 ;;
esac
[ -d "$TEMPLATE" ] || { echo "stack inconnue : $STACK (pas de $TEMPLATE)" >&2; exit 1; }
[ ! -e "$DEST" ] || { echo "existe déjà : $DEST" >&2; exit 1; }

mkdir -p "apps/$STACK"
cp -R "$TEMPLATE" "$DEST"
find "$DEST" -type f -exec sed -i "s/__SLUG__/$SLUG/g" {} +
echo "créée : $DEST"

if [ -x "stacks/$STACK/post-new-app" ]; then
  exec "stacks/$STACK/post-new-app" "$SLUG" "$DEST"
fi
