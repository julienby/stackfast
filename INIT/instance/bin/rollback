#!/usr/bin/env sh
# Revient à l'image précédente d'une app (celle d'avant le dernier update) et recrée son conteneur.
#   bin/rollback <slug>
. "$(dirname "$0")/lib.sh"

SLUG="${1:?usage: stackfast rollback <slug>}"
app_dir "$SLUG" >/dev/null
img="$(app_image "$SLUG")"
docker image inspect "$img:previous" >/dev/null 2>&1 || die "pas d'image précédente pour $SLUG"
docker tag "$img:current" "$img:swap"
docker tag "$img:previous" "$img:current"
docker tag "$img:swap" "$img:previous"
docker rmi "$img:swap" >/dev/null
compose_app "$SLUG" up -d --force-recreate --wait --wait-timeout 60 || echo "ATTENTION : $SLUG n'est pas saine" >&2
say revenue "$SLUG"
echo "Attention : l'image précédente peut contenir une faille corrigée depuis. stackfast audit."
