#!/usr/bin/env sh
# Démarre (ou met à jour) une app, ou toutes : bin/up <slug>… | bin/up --all
# Lance ce que l'app sait faire : bin/build (dépendances, CSS), puis son compose (image construite si besoin),
# attend qu'elle soit saine, puis met le proxy à jour. Le code est monté : le modifier ne demande pas de `up`.
. "$(dirname "$0")/lib.sh"

[ $# -gt 0 ] || die "usage : stackfast up <slug>… | stackfast up --all"
if [ "$1" = --all ]; then
  set -- $(apps | cut -d' ' -f2)
  [ $# -gt 0 ] || { echo "aucune app"; exec "$ROOT/bin/proxy"; }
fi

for slug in "$@"; do
  d="$(app_dir "$slug")"
  [ -f "$d/.env" ] || die "$d/.env manquant (stackfast restore, ou recrée APP_SECRET et API_TOKEN)"
  [ -x "$d/bin/build" ] && ( cd "$d" && bin/build >/dev/null ) || die "$slug : bin/build a échoué (lance-le dans $d pour voir)"
  compose_app "$slug" up -d --build --remove-orphans --wait --wait-timeout 60 \
    || die "$slug ne démarre pas sainement : stackfast logs $slug"
  say en\ ligne "$slug → $(app_url "$slug")"
done
"$ROOT/bin/proxy" >/dev/null
