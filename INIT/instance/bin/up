#!/usr/bin/env sh
# Démarre (ou met à jour la config de) une app, ou toutes : bin/up <slug>… | bin/up --all
# Construit l'image de la stack si elle manque ou si la stack a changé, attend que l'app soit saine,
# puis met le proxy à jour. Le code est monté : le modifier ne demande pas de `up`.
. "$(dirname "$0")/lib.sh"

[ $# -gt 0 ] || die "usage : stackfast up <slug>… | stackfast up --all"
if [ "$1" = --all ]; then
  set -- $(apps | cut -d' ' -f2)
  [ $# -gt 0 ] || { echo "aucune app"; exec "$ROOT/bin/proxy"; }
fi

for slug in "$@"; do
  stack="$(app_stack "$slug")"
  image_stale "$stack" && "$ROOT/bin/update" --build-only "$stack"
  [ -f "$(app_dir "$slug")/.env" ] || die "$(app_dir "$slug")/.env manquant"
  # Dépendances composer propres à l'app : installées si vendor/ manque ou si composer.lock est plus récent (après un git pull).
  d="$(app_dir "$slug")"
  if [ -f "$d/composer.lock" ] && { [ ! -f "$d/vendor/autoload.php" ] || [ "$d/composer.lock" -nt "$d/vendor/autoload.php" ]; }; then
    "$ROOT/bin/composer" "$slug" install --no-dev
  fi
  compose_app "$slug" up -d --remove-orphans --wait --wait-timeout 60 \
    || die "$slug ne démarre pas sainement : stackfast logs $slug"
  say en\ ligne "$slug → $(app_url "$slug")"
done
"$ROOT/bin/proxy" >/dev/null
