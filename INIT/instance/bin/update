#!/usr/bin/env sh
# Correctifs de sécurité (PHP, Caddy) : reconstruit l'image de chaque app avec la dernière image de base, sans toucher
# à son code, la teste, puis la bascule. Et l'image du proxy.
#   bin/update            toutes les apps + le proxy
#   bin/update <slug>…    ces apps
#   bin/update proxy      le proxy seul
# Ordre sûr par app : l'image en service devient :previous, on construit (--pull), on lance bin/check ;
# rouge → on remet :previous, l'app n'a jamais été coupée ; vert → on recrée le conteneur. `stackfast rollback <slug>` revient.
. "$(dirname "$0")/lib.sh"

update_app() {
  slug="$1"; img="$(app_image "$slug")"
  echo "== $slug"
  docker image inspect "$img:current" >/dev/null 2>&1 && docker tag "$img:current" "$img:previous"
  if ! compose_app "$slug" build --pull >/dev/null 2>&1; then
    docker image inspect "$img:previous" >/dev/null 2>&1 && docker tag "$img:previous" "$img:current"
    echo "  construction échouée : rien n'a changé (compose build --pull dans $(app_dir "$slug") pour voir)" >&2; return 1
  fi
  if ! ( cd "$(app_dir "$slug")" && bin/check >/dev/null 2>&1 ); then
    docker image inspect "$img:previous" >/dev/null 2>&1 && docker tag "$img:previous" "$img:current"
    echo "  tests rouges avec la nouvelle image : rien n'a changé, l'app tourne toujours sur l'ancienne" >&2; return 1
  fi
  compose_app "$slug" up -d --force-recreate --wait --wait-timeout 60 >/dev/null 2>&1 \
    || { echo "  ATTENTION : $slug n'est pas saine après la bascule → stackfast logs $slug, ou stackfast rollback $slug" >&2; return 1; }
  say basculée "$slug"
}

update_proxy() {
  docker compose --env-file .env -f proxy/compose.yml pull -q
  docker compose --env-file .env -f proxy/compose.yml up -d
  "$ROOT/bin/proxy" >/dev/null
  say proxy "image Caddy à jour"
}

[ $# -gt 0 ] || set -- $(apps | cut -d' ' -f2) proxy
status=0
for target in "$@"; do
  case "$target" in
    proxy) update_proxy || status=1 ;;
    *)     app_dir "$target" >/dev/null; update_app "$target" || status=1 ;;
  esac
done
echo
"$ROOT/bin/audit" || status=1
exit "$status"
