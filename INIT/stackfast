#!/usr/bin/env sh
# Client stackfast. Le hub est un clone git permanent (~/.stackfast par défaut) ;
# le CLAUDE global et les skills sont des liens vers ce clone. Git fait le sens retour.
set -eu

HUB="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
SRC="$HUB/INIT"

usage() {
  cat <<EOF
stackfast <commande>

Dans une instance (n'importe quel sous-dossier) — les apps :
  new <recette> <slug>    crée une app autonome (son dépôt dans apps/<slug>) et la met en ligne sur https://\$APPS_HOST/<slug>/
  ls                      apps, état, adresse
  domain <slug> [<dom>]   donne une adresse (app1.domaine.fr, puis domaine1.fr…) ; les anciennes redirigent
  domain <slug> --rm <d>  retire un domaine
  check [<slug>]          lint, tests, marqueurs de conflit (le bin/check de l'app)
  up <slug>… | --all      démarre / applique la config ; down <slug> arrête
  logs <slug> [-f]        logs (erreurs PHP comprises) ; shell <slug> : shell dans le conteneur
  audit                   sécurité : version PHP servie vs dernier correctif, apps sur une ancienne image
  update [<slug>|proxy]   reconstruit chaque image avec le dernier correctif PHP/Caddy, teste, bascule
  rollback <slug>         revient à l'image précédente d'une app
  composer <slug> <cmd>   dépendances composer d'une app (require, remove, update…)
  backup [<slug>…]        sauvegarde data/ + .env de chaque app, config d'instance, certificats (chiffrable)
  restore <archive> [<slug>…]  restaure (--list pour voir, --certs, --no-instance) ; l'ancien état est mis de côté
  agent …                 agents isolés : en refonte (phase 4) ; en attendant, cd apps/<slug> && claude
  deploy                  git pull + up --all (sur le VPS)
  proxy                   régénère et recharge Caddy
  migrate                 migration des anciens projets : phase 5

Le hub :
  status              changements locaux + écart avec GitHub
  pull                récupère le hub, refait les liens
  push "message"      commit + pull --rebase + push des changements locaux du hub
  link                (re)crée les liens : CLAUDE global, skills
  skill add <dossier> déplace une skill dans le hub et la relie
  init <dossier>      crée une instance (le dossier serveur : proxy, outils, apps/)
  sync [--force] [dossier]  remet bin/, .claude/ et proxy/compose.yml d'une instance au niveau du hub
                      (défaut : .) ; stop si l'un d'eux a été modifié localement, sauf --force

Hub : $HUB
EOF
}

die() { echo "stackfast : $*" >&2; exit 1; }

# link <cible> <lien> : un fichier déjà présent est sauvegardé, jamais écrasé.
link() {
  target="$1"
  lnk="$2"
  [ "$(readlink "$lnk" 2>/dev/null || true)" = "$target" ] && return 0
  mkdir -p "$(dirname "$lnk")"
  if [ -e "$lnk" ] || [ -L "$lnk" ]; then
    mv "$lnk" "$lnk.bak.$(date +%Y%m%d%H%M%S)"
    echo "sauvegardé : $lnk.bak.*"
  fi
  ln -s "$target" "$lnk"
  echo "lien       : $lnk -> $target"
}

cmd_link() {
  link "$SRC/CLAUDE.global.md" "$HOME/.claude/CLAUDE.md"
  link "$SRC/CLAUDE.global.md" "$HOME/.codex/AGENTS.md"
  link "$SRC/codex/rapide.config.toml" "$HOME/.codex/rapide.config.toml"
  link "$SRC/codex/fort.config.toml" "$HOME/.codex/fort.config.toml"
  for skill in "$SRC"/skills/*/; do
    [ -d "$skill" ] || continue
    link "${skill%/}" "$HOME/.claude/skills/$(basename "$skill")"
  done
}

cmd_status() {
  git -C "$HUB" fetch --quiet
  git -C "$HUB" status --short --branch
}

cmd_pull() {
  git -C "$HUB" pull --ff-only
  cmd_link
}

cmd_push() {
  [ -n "${1:-}" ] || die 'message requis : stackfast push "message"'
  git -C "$HUB" add -A
  git -C "$HUB" commit -m "$1"
  git -C "$HUB" pull --rebase \
    || die "pull --rebase a échoué dans $HUB. Si conflit : corrige les fichiers, git add, git rebase --continue, puis git push (ou git rebase --abort)"
  git -C "$HUB" push
}

cmd_skill_add() {
  dir="${1:-}"
  [ -d "$dir" ] || die "pas un dossier : $dir"
  [ -L "$dir" ] && die "déjà un lien : $dir"
  [ -f "$dir/SKILL.md" ] || die "pas de SKILL.md dans $dir"
  name="$(basename "$dir")"
  [ -e "$SRC/skills/$name" ] && die "skill déjà dans le hub : $name"
  mkdir -p "$SRC/skills"
  mv "$dir" "$SRC/skills/$name"
  echo "déplacé    : $dir -> $SRC/skills/$name"
  link "$SRC/skills/$name" "$HOME/.claude/skills/$name"
  echo "Ensuite : stackfast push \"Ajoute la skill $name\""
}

# Instance : copiée SANS écraser un fichier déjà présent.
cmd_init() {
  dest="${1:-}"
  [ -n "$dest" ] || die "dossier requis : stackfast init <dossier>"
  mkdir -p "$dest"
  ( cd "$SRC/instance" && find . \( -type f -o -type l \) ) | while read -r f; do
    if [ -e "$dest/$f" ] || [ -L "$dest/$f" ]; then
      echo "conservé   : $f"
    else
      mkdir -p "$dest/$(dirname "$f")"
      cp -P "$SRC/instance/$f" "$dest/$f"
      echo "créé       : $f"
    fi
  done
  cmd_sync "$dest"
  if [ ! -d "$dest/.git" ]; then
    git -C "$dest" init -q
    echo "git init   : $dest"
  fi
  echo
  echo "Prêt. Ensuite : cd $dest ; cp .env.example .env (APPS_HOST, HOST_UID) ; stackfast new php-htmx <slug>."
}

# Manifeste écrit à chaque sync : ce que le hub a posé. Sert à repérer les modifs locales.
SUMS=.stackfast-sums

# sums <dossier> : sha256 de chaque fichier, hors vendor/ et hors manifeste.
sums() {
  ( cd "$1" && find . -type f ! -path './vendor/*' ! -name "$SUMS" -exec sha256sum {} + | sort -k2 )
}

# bin/, .claude/ et proxy/compose.yml de l'instance : les fichiers du hub, posés un par un (settings.local.json reste).
# Stop si un fichier posé a été modifié ou supprimé depuis la dernière sync, sauf --force.
# Sans manifeste (instance d'avant) : stop si un fichier présent diffère du hub.
# proxy/Caddyfile et proxy/domains appartiennent à l'instance : posés s'ils manquent, jamais écrasés.
sync_owned() {
  force="$1"; dest="$2"
  for f in proxy/Caddyfile proxy/domains; do
    [ -e "$dest/$f" ] || { mkdir -p "$dest/proxy"; cp "$SRC/instance/$f" "$dest/$f"; echo "créé       : $f"; }
  done
  owned="$( cd "$SRC/instance" && { find bin .claude -type f; echo proxy/compose.yml; } | sort )"
  if [ "$force" -eq 0 ]; then
    if [ -f "$dest/$SUMS" ]; then
      changed="$( cd "$dest" && sha256sum -c --quiet "$SUMS" 2>/dev/null | cut -d: -f1 )"
    else
      changed="$( echo "$owned" | while read -r f; do
        if [ -e "$dest/$f" ] && ! cmp -s "$SRC/instance/$f" "$dest/$f"; then echo "$f"; fi
      done )"
    fi
    if [ -n "$changed" ]; then
      echo "Modifs locales dans bin/ ou .claude/ (différents du hub) :" >&2
      echo "$changed" >&2
      die "reporte-les dans le hub, ou écrase-les : stackfast sync --force"
    fi
  fi
  if [ -f "$dest/$SUMS" ]; then
    cut -c67- "$dest/$SUMS" | while read -r f; do
      [ -e "$SRC/instance/$f" ] || rm -f "$dest/$f"
    done
  fi
  echo "$owned" | while read -r f; do
    mkdir -p "$dest/$(dirname "$f")"
    cp "$SRC/instance/$f" "$dest/$f"
  done
  ( cd "$SRC/instance" && echo "$owned" | xargs sha256sum ) > "$dest/$SUMS"
  echo "instance   : bin/ .claude/ proxy/compose.yml (synchronisés)"
}

# Remet les outils de l'instance (bin/, .claude/, proxy/compose.yml) au niveau du hub. Ne touche jamais apps/ :
# chaque app est autonome et porte sa propre copie de la recette (stackfast upgrade <app> pour la faire évoluer).
cmd_sync() {
  force=0
  [ "${1:-}" = --force ] && { force=1; shift; }
  dest="${1:-.}"
  sync_owned "$force" "$dest"
  # Ancien modèle : la stack partagée copiée dans l'instance ne sert plus.
  [ -d "$dest/stacks" ] && echo "note       : $dest/stacks/ ne sert plus (les recettes restent dans le hub) ; supprime-le quand plus aucune app de l'ancien modèle ne tourne"
  return 0
}

# Commande d'instance : remonte jusqu'à la racine de l'instance (bin/lib.sh) et lance bin/<commande>.
cmd_instance() {
  name="$1"; shift
  dir="$PWD"
  while [ "$dir" != / ] && [ ! -f "$dir/bin/lib.sh" ]; do dir="$(dirname "$dir")"; done
  [ -f "$dir/bin/lib.sh" ] || die "$name : à lancer dans une instance (aucun bin/lib.sh au-dessus de $PWD)"
  [ -x "$dir/bin/$name" ] || die "$name : commande absente de l'instance ($dir/bin/$name) — stackfast sync ?"
  # Le client sait où est le hub : les commandes d'instance y trouvent la méthode (CLAUDE.global.md) pour les sandboxes d'agents.
  STACKFAST_HOME="$HUB" exec "$dir/bin/$name" "$@"
}

cmd="${1:-}"
[ $# -gt 0 ] && shift
case "$cmd" in
  status)  cmd_status ;;
  pull)    cmd_pull ;;
  push)    cmd_push "$@" ;;
  link)    cmd_link ;;
  skill)   [ "${1:-}" = add ] || die "usage : stackfast skill add <dossier>"; shift; cmd_skill_add "$@" ;;
  init)    cmd_init "$@" ;;
  sync)    cmd_sync "$@" ;;
  new-app) cmd_instance new "$@" ;;
  new|ls|domain|check|up|down|logs|shell|audit|update|rollback|deploy|proxy|migrate|agent|backup|restore|composer)
           cmd_instance "$cmd" "$@" ;;
  *)       usage ;;
esac
