# Serveur d'une app php-htmx (dans son conteneur). Remplace Apache et .htaccess.
# HTTP seul sur :8080 : le TLS, les domaines et X-Base-Path sont l'affaire du proxy de l'instance.
{
	admin off
	auto_https off
	persist_config off
	frankenphp {
		num_threads 4
	}
}

:8080 {
	root * /app
	encode zstd gzip

	# Jamais servis : code, vues, données, tests, services (comme l'ancien .htaccess).
	@private_dirs path /lib /lib/* /views /views/* /data /data/* /tests /tests/* /services /services/*
	# Fichiers sensibles qui existent sur le disque (une route /x.json qui n'est pas un fichier passe à index.php).
	@private_files {
		path */.* *.md *.json *.lock *.log *.tmp *.yml *.yaml *.ini *.sh *.sqlite *.db
		file
	}

	route {
		respond @private_dirs 404
		respond @private_files 404
		php_server
	}
}
