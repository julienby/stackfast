#!/usr/bin/env sh
# Audit de l'image php-htmx : version PHP réellement servie vs dernier correctif publié sur php.net,
# et réglages de durcissement actifs. Lancé par bin/audit : stacks/php-htmx/audit <image>.
# Exit 1 = action nécessaire (le message dit laquelle).
set -eu
IMAGE="${1:?usage: stacks/php-htmx/audit <image>}"
status=0

# Ce que voit le serveur web, pas un php de l'hôte.
set -- $(docker run --rm --network none "$IMAGE" php -r '
  echo PHP_VERSION, " ",
       ini_get("session.upload_progress.enabled") ? "1" : "0", " ",
       ini_get("fatal_error_backtraces") ? "1" : "0", " ",
       ini_get("display_errors") ? "1" : "0";')
current="$1"
branch="$(echo "$current" | cut -d. -f1,2)"
echo "  $(docker run --rm --network none "$IMAGE" frankenphp version 2>/dev/null | head -1)"

latest="$(curl -fsS --max-time 10 "https://www.php.net/releases/index.php?json&version=$branch" 2>/dev/null \
  | sed -n 's/.*"version":"\([0-9.]*\)".*/\1/p')"
if [ -z "$latest" ]; then
  echo "  PHP $current : dernier correctif inconnu (php.net injoignable)"
  status=1
elif [ "$(printf '%s\n%s\n' "$current" "$latest" | sort -V | tail -1)" != "$current" ]; then
  echo "  PHP $current : OBSOLÈTE, $latest est publié → stackfast update php-htmx"
  echo "    (si l'image amont n'a pas encore $latest, réessaie dans quelques heures)"
  status=1
else
  echo "  PHP $current : à jour (dernier correctif $branch : $latest)"
fi

[ "$2" = 0 ] || { echo "  session.upload_progress.enabled actif (doit être 0)"; status=1; }
[ "$3" = 0 ] || { echo "  fatal_error_backtraces actif (doit être 0)"; status=1; }
[ "$4" = 0 ] || { echo "  display_errors actif (doit être Off)"; status=1; }
exit "$status"
