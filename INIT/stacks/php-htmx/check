#!/usr/bin/env sh
# Vérifie la stack php-htmx : lint + tests CLI. Lancé par bin/check depuis la racine de l'instance.
#   stacks/php-htmx/check          toutes les apps
#   stacks/php-htmx/check demo     une app
set -eu
SLUG="${1:-}"
status=0

# Exécute php sur un fichier, en local si php est installé, sinon dans le conteneur de la stack.
php_run() {
  if command -v php >/dev/null 2>&1; then
    php "$@"
  else
    # Chaque chemin de l'hôte devient son chemin dans le conteneur (les options comme -l restent telles quelles).
    set -- $(for a in "$@"; do echo "$a" | sed -e 's#^apps/php-htmx#/var/www/html#' -e 's#^stacks/php-htmx#/var/www/stacks/php-htmx#'; done)
    docker compose --env-file .env -f stacks/php-htmx/docker-compose.yml exec -T web php "$@"
  fi
}

scope="apps/php-htmx"
[ -n "$SLUG" ] && scope="apps/php-htmx/$SLUG"
[ -d "$scope" ] || { echo "rien à vérifier : $scope absent"; exit 0; }
lint=0
for f in $(find stacks/php-htmx/lib "$scope" -name '*.php' -not -path '*/vendor/*'); do
  php_run -l "$f" >/dev/null 2>&1 || { php_run -l "$f" 2>&1 | head -1; lint=1; }
done
[ "$lint" -eq 0 ] && echo "lint php : ok" || { echo "lint php : FAIL"; status=1; }
for t in $(find "$scope" -path '*/tests/*_test.php' | sort); do
  echo "== $t"
  php_run "$t" || status=1
done
exit "$status"
