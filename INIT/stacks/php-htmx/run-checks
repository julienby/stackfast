#!/usr/bin/env sh
# Lint + tests d'une app php-htmx, avec le php de l'environnement courant (image de la stack ou sandbox d'agent).
# Appelé par stacks/php-htmx/check (conteneur jetable) et par les agents (stacks/php-htmx/run-checks, dans leur sandbox).
#   APP_DIR (défaut /app)   LIB_DIR (défaut /stacks/php-htmx/lib)
set -eu
APP_DIR="${APP_DIR:-/app}"
LIB_DIR="${LIB_DIR:-/stacks/php-htmx/lib}"

status=0
lint=0
for f in $(find "$LIB_DIR" "$APP_DIR" -name '*.php' -not -path '*/vendor/*' -not -path "$APP_DIR/data/*"); do
  php -l "$f" >/dev/null 2>&1 || { php -l "$f" 2>&1 | head -1; lint=1; }
done
[ "$lint" -eq 0 ] && echo "lint php : ok" || { echo "lint php : FAIL"; status=1; }

# Marqueurs de conflit (laissés par `stackfast agent apply`) : dans une vue HTML, php -l ne les voit pas.
conflicts="$(grep -rnE '^(<<<<<<<|>>>>>>>) ' "$APP_DIR" --include='*.php' --include='*.md' --include='*.json' \
  --exclude-dir=vendor --exclude-dir=data 2>/dev/null || true)"
if [ -n "$conflicts" ]; then echo "$conflicts" | head -5; echo "conflits : FAIL (résous les marqueurs <<<<<<< / >>>>>>>)"; status=1
else echo "conflits : aucun marqueur"; fi
for t in $(find "$APP_DIR/tests" -name '*_test.php' 2>/dev/null | sort); do
  echo "== ${t#$APP_DIR/}"
  php "$t" || status=1
done
exit "$status"
