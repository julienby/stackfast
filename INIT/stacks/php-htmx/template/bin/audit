#!/usr/bin/env sh
# Audit de sécurité propre à cette recette : PHP servi vs dernier correctif publié, réglages de durcissement,
# failles connues des dépendances composer. Depuis l'hôte ; exit 1 si une action est nécessaire. stackfast audit l'appelle.
set -eu
cd "$(dirname "$0")/.."
img="${STACKFAST_INSTANCE:-main}-$(basename "$PWD"):current"
status=0

if ! docker image inspect "$img" >/dev/null 2>&1; then
  echo "  image absente : stackfast up $(basename "$PWD")"; exit 1
fi
set -- $(docker run --rm --network none --entrypoint php "$img" -r '
  echo PHP_VERSION, " ", ini_get("session.upload_progress.enabled") ? "1" : "0", " ",
       ini_get("fatal_error_backtraces") ? "1" : "0", " ", ini_get("display_errors") ? "1" : "0";')
current="$1"; branch="$(echo "$current" | cut -d. -f1,2)"
latest="$(curl -fsS --max-time 10 "https://www.php.net/releases/index.php?json&version=$branch" 2>/dev/null \
  | sed -n 's/.*"version":"\([0-9.]*\)".*/\1/p')"
if [ -z "$latest" ]; then echo "  PHP $current : dernier correctif inconnu (php.net injoignable)"; status=1
elif [ "$(printf '%s\n%s\n' "$current" "$latest" | sort -V | tail -1)" != "$current" ]; then
  echo "  PHP $current : OBSOLÈTE, $latest est publié → stackfast update"; status=1
else echo "  PHP $current : à jour"; fi
[ "$2" = 0 ] || { echo "  session.upload_progress.enabled actif (doit être 0)"; status=1; }
[ "$3" = 0 ] || { echo "  fatal_error_backtraces actif (doit être 0)"; status=1; }
[ "$4" = 0 ] || { echo "  display_errors actif (doit être Off)"; status=1; }

if [ ! -f composer.lock ] || grep -q '"packages": \[\]' composer.lock; then
  echo "  dépendances : aucune"
else
  if out="$(docker run --rm -u "$(id -u):$(id -g)" -e COMPOSER_HOME=/tmp/composer -v "$PWD:/app:ro" -w /app composer:2 \
      composer audit --locked --no-interaction 2>&1)"; then
    echo "  dépendances : aucune faille connue"
  else
    echo "  dépendances : FAILLES"; echo "$out" | sed 's/^/    /' | head -12; status=1
  fi
fi
exit "$status"
